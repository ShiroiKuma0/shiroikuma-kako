# 白い熊 火狐 — artifact build of Firefox for Android (Fenix), arm64 only.
# Prebuilt GeckoView is fetched for the checked-out revision; only
# Kotlin/Java compiles locally. Use via: export MOZCONFIG=$PWD/tools/kako/mozconfig
ac_add_options --enable-project=mobile/android
ac_add_options --enable-artifact-builds
ac_add_options --target=aarch64
# NOTE (2026-09-06): --enable-appservices-in-tree is OFF. It builds the app-services
# Kotlin from the vendored source, but libmegazord.so is produced by the Gecko native
# build (megazords/full -> fenix-dylib), which an artifact build never runs -- the app
# then dies on launch with UnsatisfiedLinkError: library "libmegazord.so" not found.
# Re-enabling it needs the megazord built too; see CLAUDE.md.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-kako
